      "question_ids": []
    },
    {
      "row_id": "GBK29-P517-T03-SCOPE",
      "source_cells": [
        "3. 39వ రాజ్యాంగ సవరణ (1975)",
        "ఇందిరా నెహ్రూ గాంధీ v/s రాజ్‌నారాయణ్",
        "ఆర్టికల్ 329ఎ ప్రధానమంత్రి, స్పీకర్ ఎన్నిక వివాదాన్ని విచారించే ప్రత్యేక ట్రిబ్యునల్"
      ],
      "precise_scope_to_reconcile": "39th329A4notentireamendment",
