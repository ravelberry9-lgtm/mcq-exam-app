<title>పాఠం 29: Communication, postal system and tourism</title>
<style>

















:root{color-scheme:light;--ink:#20302d;--muted:#526760;--green:#125b4c;--deep:#083d36;--mint:#e5f4ed;--paper:#fffefa;--sand:#f6efe1;--line:#dbe5dc;--accent:#d99a3d;font-family:system-ui,'Noto Sans Telugu','Nirmala UI','Gautami',sans-serif;font-size:16px;line-height:1.8}

















*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:#eaf0eb;color:var(--ink)}a{color:#086959;text-decoration-thickness:1px;text-underline-offset:3px}a:hover,a:focus-visible{color:#064b3f;text-decoration-thickness:2px}a:focus-visible{outline:3px solid #e8a449;outline-offset:3px}

















.page{max-width:1080px;min-height:100vh;margin:auto;background:var(--paper);box-shadow:0 16px 70px #143a2820}.hero{background:radial-gradient(circle at 85% 5%,#307c68 0,transparent 31%),linear-gradient(128deg,#083d36,#176b57);color:white;padding:clamp(27px,5vw,56px) clamp(20px,6vw,74px) clamp(30px,5vw,60px);position:relative;overflow:hidden}.hero:after{content:'';position:absolute;width:220px;height:220px;right:-80px;bottom:-125px;border:2px solid #d8f7df57;border-radius:50%;box-shadow:0 0 0 35px #d8f7df16,0 0 0 70px #d8f7df0c;pointer-events:none}.eyebrow{display:inline-flex;align-items:center;gap:8px;font-size:.78rem;font-weight:750;letter-spacing:.08em;text-transform:uppercase;color:#c8f4d9}.eyebrow:before{content:'';width:9px;height:9px;background:#e9b657;border-radius:50%}.hero h1{font-size:clamp(1.8rem,4vw,3.2rem);line-height:1.36;letter-spacing:-.025em;max-width:820px;margin:17px 0}.hero p{max-width:730px;margin:0;color:#e1f2e9}.hero .tags{display:flex;flex-wrap:wrap;gap:8px;margin-top:21px}.hero .tags span{border:1px solid #d8f6e363;background:#ffffff15;padding:4px 12px;border-radius:100px;font-size:.77rem;font-weight:650}

















.body{padding:clamp(20px,5vw,58px) clamp(20px,6vw,74px) 68px}.body>*{max-width:79ch}.body>h2,.body>h3,.body>.table-wrap{max-width:none}.body>p{margin:0 0 1.15em}.body>p:first-child{font-size:1.07rem;color:#3d5850}.body h2{font-size:clamp(1.4rem,2.5vw,1.85rem);line-height:1.42;color:var(--deep);margin:2.1em 0 .68em;padding-top:.3em;border-top:1px solid var(--line)}.body h2:first-child{border:0;margin-top:0}.body h3{font-size:1.16rem;line-height:1.48;color:var(--green);margin:1.9em 0 .55em}.body h2+h3{margin-top:.8em}.body strong{color:#0d5549}.body ul,.body ol{padding-left:1.5em;margin:0 0 1.3em}.body li{padding-left:.25em;margin:.4em 0}.body li::marker{color:var(--green)}.body blockquote{margin:1.5em 0;padding:15px 22px;border-left:5px solid var(--accent);border-radius:0 16px 16px 0;background:#fff5e5;color:#51422d}.body blockquote p:last-child{margin-bottom:0}.body hr{border:0;border-top:1px solid var(--line);margin:2em 0}

















.table-wrap{overflow-x:auto;margin:1.4em 0 1.8em;border:1px solid var(--line);border-radius:16px;background:white;box-shadow:0 7px 24px #163e2a0b}.body table{border-collapse:collapse;width:100%;min-width:560px;font-size:.94rem;line-height:1.65}.body th{background:#e4f2e9;color:#103f35;text-align:left;font-weight:750}.body td,.body th{padding:12px 15px;border-bottom:1px solid var(--line);vertical-align:top}.body tr:last-child td{border-bottom:0}.body tbody tr:nth-child(even){background:#f8fbf8}.body code{background:#eef4ef;padding:.12em .3em;border-radius:5px;overflow-wrap:anywhere}.body img{display:block;max-width:100%;height:auto;margin:1.5em auto;border-radius:15px}.endnote{border-top:1px solid var(--line);padding:22px clamp(20px,6vw,74px) 35px;color:var(--muted);font-size:.82rem;background:#f6faf6}.endnote p{margin:0}.back{display:inline-flex;align-items:center;gap:5px;margin-bottom:18px;color:var(--green);font-size:.9rem;font-weight:700;text-decoration:none}

















.data-figure{max-width:none!important;margin:1.8em 0;padding:clamp(16px,3vw,28px);background:linear-gradient(145deg,#eef7f0,#f8f4e8);border:1px solid #cde0d3;border-radius:20px;box-shadow:0 10px 28px #22462a12}.data-figure figcaption{font-size:1.08rem;line-height:1.5;color:var(--deep);margin-bottom:17px}.data-figure .bars{display:grid;gap:11px}.bar-row{display:grid;grid-template-columns:minmax(125px,180px) minmax(80px,1fr) 32px;gap:12px;align-items:center;font-weight:700;font-size:.9rem;line-height:1.3}.bar-row small{display:block;font-weight:500;color:var(--muted);font-size:.76rem}.bar-track{height:21px;background:#dce7db;border-radius:99px;overflow:hidden}.bar-track i{display:block;height:100%;background:linear-gradient(90deg,#167963,#43ad86);border-radius:99px}.bar-row.control .bar-track i{background:linear-gradient(90deg,#a97533,#dfac5a)}.bar-row b{font-variant-numeric:tabular-nums;color:var(--deep)}.data-figure p{font-size:.81rem;line-height:1.55;color:var(--muted);margin:17px 0 0}

















@media(max-width:620px){:root{font-size:15.5px}.hero{padding-top:28px}.body{padding-bottom:42px}.body h2{margin-top:1.65em}.body table{min-width:500px}.table-wrap{margin-left:-4px;margin-right:-4px}.body td,.body th{padding:10px 12px}.bar-row{grid-template-columns:95px minmax(50px,1fr) 25px;gap:7px;font-size:.79rem}.bar-row small{font-size:.69rem}.data-figure{margin-left:-4px;margin-right:-4px}}

















@media print{@page{size:A4;margin:15mm}body{background:white}.page{box-shadow:none;max-width:none}.hero{padding:18px 23px 22px;print-color-adjust:exact;-webkit-print-color-adjust:exact}.hero h1{font-size:23pt}.body{padding:12px 23px 20px}.body h2{break-after:avoid}.body h3{break-after:avoid}.body p,.body li{orphans:3;widows:3}.table-wrap{overflow:visible;box-shadow:none;break-inside:avoid}.body table{min-width:0}.endnote{padding:13px 23px}.back{display:none}}

















