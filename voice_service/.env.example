# Voice service (separate Railway service, root directory = voice_service)
SECRET_KEY=            # EXACTLY the same value as the main app
DATABASE_URL=          # same Postgres as the main app (Railway reference variable)
APP_ORIGINS=https://YOUR-MAIN-APP-DOMAIN
TUTOR_PROVIDER=gemini  # gemini | openai
TUTOR_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
OPENAI_API_KEY=
SARVAM_API_KEY=        # optional third recognizer
STT_PROVIDERS=gemini,openai,sarvam
DAILY_COST_CAP_USD=2
